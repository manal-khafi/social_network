# =========================================================================
# Copy to .env and fill in. Loaded by docker-compose:
#   - ${VAR} interpolation in docker-compose.yaml
#   - passed into the backend container via `env_file`
# NEVER commit the real .env. Generate secrets with:
#   openssl rand -hex 48   (JWT / reset / email verify secrets)
#   openssl rand -hex 32   (TWO_FACTOR_ENCRYPTION_KEY)
# =========================================================================

# ---------------- Postgres ----------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=socielle_network

# ---------------- Backend: database ----------------
# Host MUST be "db" (the compose service name). Keep user/password/db in sync
# with the POSTGRES_* values above.
DATABASE_URL=postgresql://postgres:CHANGE_ME_strong_db_password@db:5432/socielle_network?schema=public
# Direct (non-pooled) connection for `prisma migrate`. Not needed with the
# bundled "db" container (it defaults to DATABASE_URL); set it only when
# DATABASE_URL points at a pooler such as Neon's pooled host.
# DIRECT_URL=

# ---------------- Backend: runtime ----------------
PORT=3500
# Max size of JSON / urlencoded request bodies (not file uploads)
BODY_LIMIT=1mb
# Public site URL(s), comma-separated. Used for CORS.
ALLOWED_ORIGINS=https://your-domain.com
# Public URL of the frontend. Used to build email verification / reset links.
FRONTEND_URL=https://your-domain.com
APP_NAME=Social Network
# GLOBAL_RATE_LIMIT=1000
# LOG_LEVEL=info
# Giphy GIF stickers (get a key at https://developers.giphy.com). Empty = GIFs disabled.
GIPHY_API_KEY=

# WebRTC TURN relay (optional). Empty = STUN-only. Free tier at metered.ca.
TURN_URL=
TURN_USER=
TURN_PASS=

# ---------------- Backend: JWT / auth secrets (all REQUIRED) ----------------
AUTH_SECRET=CHANGE_ME
AUTH_SECRET_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=CHANGE_ME
AUTH_REFRESH_SECRET_EXPIRES_IN=24h
RESET_SECRET=CHANGE_ME
RESET_EXPIRES_IN=15m
EMAIL_VERIFY_SECRET=CHANGE_ME
EMAIL_VERIFY_EXPIRES_IN=24h

# Email verification at sign-up is REQUIRED unless this is "true".
# "true" marks new accounts verified immediately, without sending an email:
# a development convenience only (e.g. no SMTP locally). Keep "false" in production.
AUTH_AUTO_VERIFY=false

# Password-reset module (src/services/authService.ts) - separate secret
RESET_PASSWORD_SECRET=CHANGE_ME
RESET_PASSWORD_EXPIRES_IN=15m

# 2FA secret encryption (AES-256-GCM key, 32 bytes hex)
TWO_FACTOR_ENCRYPTION_KEY=CHANGE_ME

# ---------------- Backend: Firebase Admin (Google / Facebook sign-in) ----------------
# Optional: leave all three empty to run without social login (it answers 503).
# Provide the service account ONE way:
#   FIREBASE_SERVICE_ACCOUNT_PATH = path to the JSON file INSIDE the backend container
#                                   (mount it as a volume or secret), or
#   FIREBASE_SERVICE_ACCOUNT      = the whole JSON on a single line
# Download it from Firebase console > Project settings > Service accounts.
# NEVER commit the JSON file or its contents.
FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_FIREBASE_PROJECT_ID","private_key_id":"YOUR_PRIVATE_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@YOUR_FIREBASE_PROJECT_ID.iam.gserviceaccount.com","client_id":"YOUR_CLIENT_ID"}
# Only needed for server-side Firebase Storage access.
FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_PROJECT_ID.appspot.com

# ---------------- Backend: SMTP ----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# ---------------- Frontend (baked into the bundle at build time) ----------------
VITE_API_URL=/api
# Realtime (Socket.IO). Empty = same origin, proxied by nginx at /socket.io/.
VITE_SOCKET_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
