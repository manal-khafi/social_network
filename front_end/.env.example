# Frontend build-time config (Vite inlines VITE_* into the bundle).

# API base URL. "/api" routes through the reverse proxy on the same origin.
# Use a full URL (e.g. https://api.example.com/api) if the API is on another host.
VITE_API_URL=/api

# Firebase web config - public values, safe to expose in the client bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Realtime endpoint. Empty = same origin.
VITE_SOCKET_URL=
