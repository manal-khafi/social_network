# =========================================================================
# Backend environment (local dev). In Docker these come from the repo-root
# .env via docker-compose `env_file`. Generate every secret with:
#   openssl rand -hex 48        (JWT / reset / email secrets)
#   openssl rand -hex 32        (TWO_FACTOR_ENCRYPTION_KEY)
# =========================================================================

NODE_ENV=development
PORT=3500
# Max size of JSON / urlencoded request bodies (not file uploads)
BODY_LIMIT=1mb

# Postgres connection string. In Docker the host is the compose service "db".
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/socielle_network?schema=public
# Direct (non-pooled) connection, used only by `prisma migrate`. Optional:
# defaults to DATABASE_URL (see prisma.config.ts), which is right for a local
# or Docker Postgres.
# DIRECT_URL=

# --- Neon (production): two URLs, both from the Neon dashboard ---
#   DATABASE_URL = the POOLED connection (host contains "-pooler"), used by the app
#   DIRECT_URL   = the DIRECT connection, required for migrations
# DATABASE_URL=postgresql://user:password@pooled-host/neondb?sslmode=require
# DIRECT_URL=postgresql://user:password@direct-host/neondb?sslmode=require

# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# Public URL of the frontend - used to build email verification / reset links
FRONTEND_URL=http://localhost:5173

# Shown in email footers
APP_NAME=Social Network

# ---- JWT / auth (src/util/jwt.ts - all four secrets are REQUIRED) ----
AUTH_SECRET=CHANGE_ME
AUTH_SECRET_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=CHANGE_ME
AUTH_REFRESH_SECRET_EXPIRES_IN=24h
RESET_SECRET=CHANGE_ME
RESET_EXPIRES_IN=15m
EMAIL_VERIFY_SECRET=CHANGE_ME
EMAIL_VERIFY_EXPIRES_IN=24h

# Email verification at sign-up is REQUIRED unless this is "true".
# "true" marks new accounts verified immediately, without sending an email:
# a development convenience only (e.g. no SMTP locally). Keep "false" in production.
AUTH_AUTO_VERIFY=false

# ---- Password reset module (src/services/authService.ts) ----
RESET_PASSWORD_SECRET=CHANGE_ME
RESET_PASSWORD_EXPIRES_IN=15m

# ---- 2FA secret encryption (AES-256-GCM key, 32 bytes hex) ----
TWO_FACTOR_ENCRYPTION_KEY=CHANGE_ME

# ---- Firebase Admin (Google / Facebook sign-in, src/config/fireBase.ts) ----
# Optional: leave all three empty to run without social login (it answers 503).
# Provide the service account ONE way:
#   FIREBASE_SERVICE_ACCOUNT_PATH = path to the service-account JSON file, or
#   FIREBASE_SERVICE_ACCOUNT      = the whole JSON on a single line
# Download it from Firebase console > Project settings > Service accounts.
# NEVER commit the JSON file or its contents.
FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_FIREBASE_PROJECT_ID","private_key_id":"YOUR_PRIVATE_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@YOUR_FIREBASE_PROJECT_ID.iam.gserviceaccount.com","client_id":"YOUR_CLIENT_ID"}
# Only needed for server-side Firebase Storage access.
FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_PROJECT_ID.appspot.com

# ---- SMTP ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# ---- Optional ----
# GLOBAL_RATE_LIMIT=1000

# LOG_LEVEL=debug

# Giphy GIF stickers (https://developers.giphy.com). Empty = feature disabled.
GIPHY_API_KEY=

# WebRTC TURN relay (optional). Empty = STUN-only.
TURN_URL=
TURN_USER=
TURN_PASS=
